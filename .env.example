# Alcance publicado. El MVP editorial expone solo portada, noticias y blog; el
# resto de los módulos responde 404 aunque su código siga en el repositorio.
# Es el valor por defecto: si falta la variable se publica de menos, no de más.
# Para levantar el sitio completo hay que apagarla explícitamente.
NEXT_PUBLIC_MVP_EDITORIAL=1

# Correo de contacto del pie y de las páginas legales. Sin formularios públicos
# es la única vía que se ofrece; si queda vacía, no se promete ninguna.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo servidor. Nunca usar prefijo NEXT_PUBLIC ni exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://bolsadelahabana.com

# Resend (email). NO SE USA en el MVP editorial: el sitio no envía ni un correo
# —sin formularios, sin boletín, sin confirmación de cuenta ni recuperación de
# contraseña—. Estas tres se dejan sin declarar salvo que se levante el sitio
# completo con NEXT_PUBLIC_MVP_EDITORIAL=0.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=BVH <notificaciones@your-verified-domain.com>
EMAIL_TO=contacto@your-domain.com

# Antiabuso de formularios públicos. Tampoco aplica en el MVP editorial: sin
# endpoints públicos no hay nada que limitar ni que verificar.
# El límite funciona sin configurar nada: 5 envíos por cliente y ruta cada
# 300 s. Estas variables solo lo ajustan.
FORMS_RATE_LIMIT=5
FORMS_RATE_LIMIT_WINDOW=300
# Sal del hash con el que se identifica al cliente. La base nunca ve una IP.
RATE_LIMIT_SALT=cambiar-por-entorno

# Turnstile. Sin estas dos claves el widget no se renderiza y la verificación
# no se interpone: el sitio funciona igual. Con ellas queda activo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
