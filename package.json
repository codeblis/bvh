{
	"name": "bvh",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.19.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:db": "supabase test db --local",
		"test:concurrency": "supabase/tests/course_enrollment_concurrency.test.sh",
		"test:e2e": "node scripts/test-e2e.mjs",
		"test:e2e:mvp": "E2E_MVP_EDITORIAL=1 node scripts/test-e2e.mjs --config=playwright.mvp.config.ts",
		"start": "next start",
		"lint": "biome lint",
		"format": "biome format --write",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy:sitio": "node scripts/deploy.mjs sitio",
		"deploy:app": "node scripts/deploy.mjs app",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"gen:types": "supabase gen types typescript --local --schema public > src/types/supabase.ts",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.110.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.24.0",
		"next": "16.2.10",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"recharts": "^3.9.2",
		"resend": "^6.17.2",
		"shadcn": "^4.13.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@opennextjs/cloudflare": "^1.20.1",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"babel-plugin-react-compiler": "1.0.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.110.0"
	}
}
